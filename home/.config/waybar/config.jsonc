{
  "layer": "bottom",
  "position": "top",
  "height": 40,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "exclusive": true,
  "modules-left": [
    "custom/launcher",
    "clock",
    "pulseaudio",
    "mpris"
  ],
  "modules-center": [
    "hyprland/workspaces",
    "wlr/taskbar"
  ],
  "modules-right": [
    "tray",
    "cpu",
    "memory",
    "network",
    "battery",
    "custom/power"
  ],
  "custom/launcher": {
    "format": "<span font_family='Cascadia Code NF' font_size='125%' rise='-1500'></span>",
    "tooltip-format": "Search apps (or tap Super)",
    "on-click": "sh -c '$HOME/.local/bin/rice open launcher'"
  },
  "clock": {
    "format": "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>  {:%I:%M:%S %p}",
    "format-alt": "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>  {:%a %d %b}",
    "interval": 1,
    "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>  muted",
    "format-icons": {
      "default": [
        "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>",
        "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>",
        "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>"
      ]
    },
    "on-click": "pavucontrol",
    "scroll-step": 5
  },
  "mpris": {
    "format": "{status_icon}  {title}",
    "max-length": 32,
    "status-icons": {
      "playing": "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>",
      "paused": "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>",
      "stopped": "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>"
    },
    "tooltip-format": "{title} · {artist}"
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "persistent-workspaces": {
      "*": 5
    },
    "on-click": "activate"
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": [
      "rice-sys",
      "rice-rain",
      "rice-clock",
      "rice-wave",
      "rice-keys"
    ]
  },
  "tray": {
    "spacing": 10,
    "icon-size": 16
  },
  "cpu": {
    "format": "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>  {usage}%",
    "interval": 2,
    "on-click": "sh -c '$HOME/.local/bin/rice hud'"
  },
  "memory": {
    "format": "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>  {percentage}%",
    "interval": 2,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
    "on-click": "sh -c '$HOME/.local/bin/rice hud'"
  },
  "network": {
    "format-wifi": "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>  {signalStrength}%",
    "format-ethernet": "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>  wired",
    "format-disconnected": "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>  off",
    "tooltip-format": "{essid}  {ipaddr}"
  },
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>  {capacity}%",
    "format-icons": [
      "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>",
      "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>",
      "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>",
      "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>",
      "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>"
    ],
    "states": {
      "warning": 25,
      "critical": 12
    },
    "tooltip-format": "{timeTo}"
  },
  "custom/power": {
    "format": "<span font_family='Font Awesome 7 Free' font_weight='900' font_size='112%' rise='-1000'></span>",
    "tooltip-format": "Lock, log out, restart, shut down",
    "on-click": "sh -c '$HOME/.local/bin/rice open session'"
  }
}