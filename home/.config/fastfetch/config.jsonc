{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "fedora_small",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#34}╭─────────────── Hardware ───────────────╮"
    },
    {
      "type": "host",
      "key": "  󰍹 ",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": "   ",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": "  󰍛 ",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "   ",
      "keyColor": "blue"
    },
    {
      "type": "battery",
      "key": "  󰁹 ",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "{#34}╰────────────────────────────────────────╯"
    },
    {
      "type": "custom",
      "format": "{#35}╭─────────────── Software ───────────────╮"
    },
    {
      "type": "os",
      "key": "   ",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": "   ",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": "   ",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "   ",
      "keyColor": "magenta"
    },
    {
      "type": "packages",
      "key": "  󰏖 ",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": "  󰥔 ",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "{#35}╰────────────────────────────────────────╯"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}