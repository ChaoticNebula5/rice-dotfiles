#!/usr/bin/env python3
"""rice-sync: push Caelestia's wallpaper colours into Waybar, kitty, cava and hyprlock.

usage: rice-sync once     regenerate everything now
       rice-sync watch    keep running, regenerate when the wallpaper scheme changes
"""
import json
import os
import re
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
STATE = f"{HOME}/.local/state/caelestia"
SCHEME = f"{STATE}/scheme.json"
SEQS = f"{STATE}/sequences.txt"
RICE = f"{HOME}/.config/rice"

FALLBACK = {
    "surface": "131317", "onSurface": "e5e1e7", "onSurfaceVariant": "c7c5d0",
    "primary": "c2c1ff", "onPrimary": "2a2a60", "secondary": "c6c4e0",
    "tertiary": "e8b9d5", "outline": "918f9a", "outlineVariant": "46464f",
    "error": "ffb4ab", "surfaceContainer": "1f1f23", "surfaceContainerHigh": "2a292e",
}


def snake(k):
    return "".join("_" + ch.lower() if ch.isupper() else ch for ch in k)


def load_scheme():
    try:
        with open(SCHEME) as f:
            s = json.load(f)
        c = s.get("colours") or s.get("colors") or {}
    except Exception as e:
        print("rice-sync: scheme unreadable, using fallback:", e, file=sys.stderr)
        c = {}

    def get(k):
        v = c.get(k) or c.get(snake(k)) or FALLBACK.get(k)
        return str(v).lstrip("#")[:6].lower() if v else None

    return get, c


def term_colours(get, raw):
    """16 ANSI colours + fg/bg/cursor: scheme term keys, then sequences.txt, then a material guess."""
    t = {}
    for i in range(16):
        v = raw.get(f"term{i}")
        if isinstance(v, str) and re.fullmatch(r"#?[0-9a-fA-F]{6}", v):
            t[i] = v.lstrip("#").lower()
    special = {}
    try:
        data = open(SEQS, encoding="utf-8", errors="ignore").read()
        for m in re.finditer(r"\]4;(\d+);(?:rgb:)?#?([0-9a-fA-F]{2})/?([0-9a-fA-F]{2})/?([0-9a-fA-F]{2})", data):
            i = int(m.group(1))
            if i < 16 and i not in t:
                t[i] = (m.group(2) + m.group(3) + m.group(4)).lower()
        for code, name in (("10", "fg"), ("11", "bg"), ("12", "cursor")):
            m = re.search(r"\]" + code + r";(?:rgb:)?#?([0-9a-fA-F]{2})/?([0-9a-fA-F]{2})/?([0-9a-fA-F]{2})", data)
            if m:
                special[name] = (m.group(1) + m.group(2) + m.group(3)).lower()
    except OSError:
        pass
    guess = [get("surfaceContainer"), get("error"), get("tertiary"), get("secondary"),
             get("primary"), get("tertiary"), get("secondary"), get("onSurface")]
    for i in range(16):
        t.setdefault(i, guess[i % 8])
    special.setdefault("fg", get("onSurface"))
    special.setdefault("bg", get("surface"))
    special.setdefault("cursor", get("primary"))
    return t, special


def rgb(h):
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def write(path, text):
    """Write only when the content changed. Returns True if it changed."""
    try:
        if open(path).read() == text:
            return False
    except OSError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".rice-tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)
    return True


def signal(sig, name):
    subprocess.run(["pkill", "-" + sig, "-x", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def sync():
    get, raw = load_scheme()
    term, sp = term_colours(get, raw)
    r, g, b = rgb(get("surface"))
    pr, pg, pb = rgb(get("primary"))

    # Waybar
    waybar = (
        f"@define-color background rgba({r},{g},{b},0.55);\n"
        f"@define-color foreground #{get('onSurface')};\n"
        f"@define-color color9 #{get('primary')};\n"
        f"@define-color color10 #{get('tertiary')};\n"
        f"@define-color onaccent #{get('onPrimary')};\n"
        f"@define-color border rgba({pr},{pg},{pb},0.45);\n"
        f"@define-color dim #{get('onSurfaceVariant')};\n"
    )
    if write(f"{HOME}/.config/waybar/colors.css", waybar):
        signal("SIGUSR2", "waybar")

    # kitty (main terminal and the HUD panels)
    lines = [f"# generated by rice-sync from the Caelestia scheme, do not edit",
             f"background #{sp['bg']}", f"foreground #{sp['fg']}",
             f"cursor #{sp['cursor']}", f"cursor_text_color #{sp['bg']}",
             f"selection_background #{get('primary')}", f"selection_foreground #{get('onPrimary')}",
             f"url_color #{get('tertiary')}",
             f"active_tab_background #{get('primary')}", f"active_tab_foreground #{get('onPrimary')}",
             f"inactive_tab_background #{get('surfaceContainerHigh')}", f"inactive_tab_foreground #{get('onSurfaceVariant')}",
             f"tab_bar_background none"]
    lines += [f"color{i} #{term[i]}" for i in range(16)]
    if write(f"{HOME}/.config/kitty/rice-colors.conf", "\n".join(lines) + "\n"):
        signal("SIGUSR1", "kitty")

    # cava (HUD visualiser)
    cava = f"""# generated by rice-sync, do not edit
[general]
framerate = 60
bar_width = 2
bar_spacing = 1
autosens = 1

[input]
method = pulse
source = auto

[output]
method = noncurses

[color]
gradient = 1
gradient_color_1 = '#{get('secondary')}'
gradient_color_2 = '#{get('primary')}'
gradient_color_3 = '#{get('tertiary')}'

[smoothing]
noise_reduction = 77
monstercat = 1
"""
    if write(f"{RICE}/cava.conf", cava):
        signal("SIGUSR2", "cava")

    # hyprlock
    lock = (
        "# generated by rice-sync, do not edit\n"
        f"$lock_accent = rgba({get('primary')}ff)\n"
        f"$lock_accent2 = rgba({get('tertiary')}ff)\n"
        f"$lock_text = rgba({get('onSurface')}f2)\n"
        f"$lock_dim = rgba({get('onSurfaceVariant')}b3)\n"
        f"$lock_inner = rgba({get('surface')}66)\n"
        f"$lock_fail = rgba({get('error')}ff)\n"
    )
    write(f"{HOME}/.config/hypr/hyprlock-colors.conf", lock)

    # btop: use Caelestia's generated theme when it exists, otherwise terminal colours
    conf = f"{HOME}/.config/btop/btop.conf"
    theme = "caelestia" if os.path.exists(f"{HOME}/.config/btop/themes/caelestia.theme") else "TTY"
    try:
        txt = open(conf).read()
        new = re.sub(r'(?m)^color_theme\s*=.*$', f'color_theme = "{theme}"', txt)
        if new != txt:
            write(conf, new)
    except OSError:
        pass


def mtime(p):
    try:
        return os.stat(p).st_mtime
    except OSError:
        return None


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "once"
    sync()
    if mode != "watch":
        return
    last = (mtime(SCHEME), mtime(SEQS))
    while True:
        time.sleep(2)
        now = (mtime(SCHEME), mtime(SEQS))
        if now != last:
            time.sleep(0.5)  # let Caelestia finish writing
            try:
                sync()
            except Exception as e:
                print("rice-sync:", e, file=sys.stderr)
            last = (mtime(SCHEME), mtime(SEQS))


if __name__ == "__main__":
    main()
